<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: substitute __NGIRCD__ and __HOME__ before loading. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.chatta.ngircd</string>
    <key>ProgramArguments</key>
    <array>
        <string>__NGIRCD__</string>
        <string>--nodaemon</string>
        <string>--config</string>
        <string>__HOME__/.irc-agent/ngircd.conf</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/.irc-agent/ngircd.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.irc-agent/ngircd.err.log</string>
</dict>
</plist>
